{
    "name": "@ninejuan/self-hosted-cv",
    "version": "0.1.0",
    "private": true,
    "description": "Self-hosted CV/portfolio platform inspired by ReadCV",
    "author": "ninejuan",
    "license": "Apache-2.0",
    "workspaces": [
        "apps/*"
    ],
    "scripts": {
        "postinstall": "git config core.hooksPath .githooks || true",
        "dev:server": "yarn workspace @ninejuan/cv-server start:dev",
        "dev:web": "yarn workspace @ninejuan/cv-web dev",
        "build:server": "yarn workspace @ninejuan/cv-server build",
        "build:web": "yarn workspace @ninejuan/cv-web build",
        "test:server": "yarn workspace @ninejuan/cv-server test",
        "test:web": "yarn workspace @ninejuan/cv-web typecheck",
        "lint": "yarn workspace @ninejuan/cv-server lint",
        "clean": "yarn workspaces run clean"
    },
    "engines": {
        "node": ">=22.0.0"
    }
}
