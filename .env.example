# ============================================
# Self-Hosted CV — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
# All values below are examples/defaults.

# App
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000
APP_VERSION=0.1.0

# Auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$10$REPLACE_WITH_YOUR_BCRYPT_HASH
SESSION_SECRET=replace-with-a-strong-random-secret
SESSION_IDLE_TIMEOUT=1800
SESSION_MAX_LIFETIME=86400
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=900

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cv
POSTGRES_USER=cv_user
POSTGRES_PASSWORD=cv_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO
MINIO_INTERNAL_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=cv-assets
MINIO_USE_SSL=false

# CORS
CORS_ORIGIN=http://localhost:5173

# Update Check
GITHUB_REPO=ninejuan/self-hosted-cv
DISABLE_UPDATE_CHECK=false
UPDATE_CHECK_INTERVAL=21600

# Frontend (Vite env)
VITE_API_URL=/api

# SSR (server-side only)
API_INTERNAL_URL=http://localhost:3000
