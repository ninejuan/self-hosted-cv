# ============================================
# Self-Hosted CV — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
# All values below are examples/defaults.
# Ports use 47xxx range to avoid conflicts with common services.

# App
NODE_ENV=development
APP_PORT=47300
APP_URL=http://localhost:47300
APP_VERSION=0.1.0

# Static export limits (milliseconds, object count, and bytes)
EXPORT_LOCK_TTL_MS=120000
EXPORT_MAX_EXEC_MS=60000
EXPORT_MAX_OBJECTS=100
EXPORT_MAX_OBJECT_BYTES=20971520
EXPORT_MAX_TOTAL_BYTES=104857600

# Auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
SESSION_SECRET=replace-with-a-strong-random-secret
# Generate with: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=
# Require TOTP enrollment before granting full admin access.
REQUIRE_2FA=false
SESSION_IDLE_TIMEOUT=1800
SESSION_MAX_LIFETIME=86400
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=900
# Optional dedicated HMAC key; SESSION_SECRET is used when unset.
AUTH_FAIL_HMAC_KEY=
# Deliberately lenient to prevent remote lockout of the single admin account.
AUTH_ACCOUNT_MAX_FAILURES=50
AUTH_ACCOUNT_WINDOW=900

# Audit log field length limit
AUDIT_MAX_FIELD_LEN=1024

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=47532
POSTGRES_DB=cv
POSTGRES_USER=cv_user
POSTGRES_PASSWORD=cv_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=47379

# MinIO
MINIO_INTERNAL_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:47900
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=cv-assets
MINIO_USE_SSL=false

# CORS
CORS_ORIGIN=http://localhost:47173

# Update Check
GITHUB_REPO=ninejuan/self-hosted-cv
DISABLE_UPDATE_CHECK=false
UPDATE_CHECK_INTERVAL=21600

# Frontend (Vite env — leave empty, Vite proxy handles /api routing)
VITE_API_URL=

# SSR (server-side only)
API_INTERNAL_URL=http://localhost:47300
